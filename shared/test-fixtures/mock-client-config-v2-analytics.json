{
  "apiVersion": 2,
  "configVersion": "e2e-analytics-v2-profile",
  "config": {
    "channel": {
      "name": "Test Church Channel",
      "description": "Deterministic channel used by the browser suites.",
      "language": "en",
      "copyright": "Test fixture - not a real organisation."
    },
    "features": {
