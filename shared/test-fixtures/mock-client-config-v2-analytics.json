      "exportUrl": "https://channel.example.test/api/v2/analytics",
      "exportIntervalSeconds": 1,
      "maxEventsPerBatch": 5,
      "flushOnError": true
    },
    "server": {
      "baseUrl": ""
    },
    "client": {
      "refreshIntervalSeconds": 0,
      "configFetchTimeoutSeconds": 2
    }
  }
