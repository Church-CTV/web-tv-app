{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "sourceMap": true
  },
  "include": ["ErrorHandling.ts"],
  "exclude": ["node_modules", "ui", "contracts", "**/*.test.ts"],
  "references": [
    {
      "path": "./ui"
    }
  ]
}
