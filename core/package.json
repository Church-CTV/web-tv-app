{
  "name": "@ctv/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./analytics/*": "./src/analytics/*.ts",
    "./feed/*": "./src/feed/*.ts",
    "./search/*": "./src/search/*.ts",
    "./preferences/*": "./src/preferences/*.ts",
    "./watch-later/*": "./src/watch-later/*.ts",
    "./continue-watching/*": "./src/continue-watching/*.ts",
    "./crash-reporting/*": "./src/crash-reporting/*.ts",
    "./support-bundle/*": "./src/support-bundle/*.ts",
    "./server-config/*": "./src/server-config/*.ts",
    "./i18n/*": "./src/i18n/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "^5.1.0",
    "typescript": "^5.9.3",
    "@vitest/coverage-v8": "^5.1.0"
  }
}
